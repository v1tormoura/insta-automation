# ─────────────────────────────────────────────────────────────────────────────
# Nexora — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ─────────────────────────────────────────────────────────────────────────────

# URL onde o painel é acessado (destino dos redirects do OAuth).
APP_URL=https://app.seudominio.com

# URL pública do backend. Com o docker-compose, a API fica atrás do mesmo
# domínio do painel (nginx faz proxy de /api e /public), então é igual ao APP_URL.
# A Meta baixa as mídias daqui: precisa ser HTTPS e acessível pela internet.
API_PUBLIC_URL=https://app.seudominio.com

# ── Segredos (gere valores novos para cada ambiente) ─────────────────────────
# Chave AES-256-GCM dos tokens da Meta:   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Chave anterior (somente durante uma rotação; pode ficar vazia).
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Assinatura das URLs públicas de mídia:  openssl rand -hex 32
MEDIA_SIGNING_SECRET=

# ── Instagram API with Instagram Login (Meta) ────────────────────────────────
# Painel da Meta → seu app → Instagram → API setup with Instagram login.
# Use o "Instagram app ID" e o "Instagram app secret" (não os do app do Facebook).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Precisa estar cadastrada EXATAMENTE igual em "Business login settings → OAuth redirect URIs".
# Padrão: ${API_PUBLIC_URL}/api/oauth/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Versão da Graph API (a Meta lança uma nova por trimestre).
META_GRAPH_VERSION=v25.0
# Pede login a cada autorização (permite conectar várias contas no mesmo navegador).
INSTAGRAM_OAUTH_FORCE_REAUTH=true

# ── Operação ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Quantos proxies reversos ficam na frente da API (nginx do compose = 1; + TLS = 2).
TRUST_PROXY=2
# Validade das URLs assinadas de mídia entregues à Meta (horas).
MEDIA_URL_TTL_HOURS=72
# Publicações processadas em paralelo por processo de worker (entre contas diferentes).
PUBLISH_WORKER_CONCURRENCY=20
SYNC_WORKER_CONCURRENCY=5
# Desative para bloquear novos cadastros.
SIGNUP_ENABLED=true
SESSION_TTL_DAYS=30

# ── Somente fora do docker-compose (desenvolvimento local) ───────────────────
# MONGO_URI=mongodb://127.0.0.1:27017/nexora
# REDIS_URL=redis://127.0.0.1:6379
# STORAGE_DIR=./storage
# PORT=4000
