# ─────────────────────────────────────────────────────────────────────────────
# Configuração do servidor. Copie para `.env` e preencha:
#   cp .env.example .env
# No servidor, o docker compose lê este `.env` da raiz. Em desenvolvimento, o
# backend também o lê (ou um `backend/.env`, se existir) — aí, em vez de
# DOMAIN, defina PUBLIC_URL=http://localhost:3000 e FRONTEND_URL=http://localhost:5173.
# Passo a passo completo em DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# Supabase → Connect → "Session pooler" (porta 5432). Troque [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Domínio da VPS (o registro A dele aponta para o IP do servidor). O painel
# fica em https://DOMAIN e a API em https://DOMAIN/api — o HTTPS é automático.
DOMAIN=instaflow.pro

# Login do painel.
AUTH_USERNAME=admin
AUTH_PASSWORD=troque-esta-senha

# Gere cada uma com:  openssl rand -hex 32
JWT_SECRET=
# Cifra os tokens do Instagram no banco. 64 caracteres hex. NÃO troque depois
# de conectar contas: os tokens gravados deixam de abrir (seria preciso reconectar).
ENCRYPTION_KEY=

# ── Opcionais ────────────────────────────────────────────────────────────────

# Redirect do OAuth. Padrão: https://DOMAIN/oauth-callback — cadastre exatamente
# este endereço no app da Meta.
# OAUTH_REDIRECT_URI=https://instaflow.pro/oauth-callback

# Pede login do Instagram a cada autorização (permite conectar várias contas
# seguidas no mesmo navegador). `false` desliga.
# OAUTH_FORCE_REAUTH=true

# Versão da Graph API do Instagram.
# GRAPH_API_VERSION=v21.0

# Notificações push no navegador/celular. Sem estas, o servidor gera um par na
# primeira subida e guarda no banco — só preencha para fixar um par próprio.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@seudominio.com

# E-mail (recuperação de senha — "Esqueci minha senha" no login). Sem SMTP_HOST,
# o link não aparece. Qualquer SMTP serve; com o Resend (resend.com):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_sua_chave
# SMTP_FROM tem de ser de um domínio verificado no provedor.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Nexora <nao-responda@instaflow.pro>

# Gerador de legendas com IA (console.anthropic.com). Sem a chave, o botão avisa.
# ANTHROPIC_API_KEY=

# Meta → Configurações da empresa → Segurança da marca → Domínios → meta-tag.
# Só o valor do content="...". Servido em GET / desta API.
# META_DOMAIN_VERIFICATION=

# Ritmo de publicação por conta. Sem teto diário por padrão (salvo o teto da
# própria conta); as contas publicam das 8h às 22h. 0-24 libera o dia todo.
# TETO_DIARIO_PADRAO=6-10      # liga o teto: publicações por dia, sorteadas na faixa
# JANELA_PUBLICACAO=8-22       # horas do dia em que as contas publicam
# Teto de publicações pela API por conta em 24h (padrão 50).
# IG_COTA_API_24H=50

# Trabalhos simultâneos da fila (publicações de contas diferentes em paralelo).
# WORKER_CONCURRENCY=5

# Dias que os arquivos processados ficam em disco antes da limpeza.
# RETENCAO_PROCESSED_DIAS=7
