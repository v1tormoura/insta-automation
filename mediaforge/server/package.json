{
  "name": "@mediaforge/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "doctor": "tsx src/doctor.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@mediaforge/shared": "1.0.0",
    "fastify": "5.12.5",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "4.1.11",
    "yauzl": "3.4.0"
  }
