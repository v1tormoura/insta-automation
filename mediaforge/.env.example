# MediaForge — configuração de exemplo.
# Copie para ".env" (na pasta mediaforge/) e ajuste. Todas as variáveis são opcionais.

# ── Rede ────────────────────────────────────────────────────────────────────
# 127.0.0.1 = acessível só neste computador (recomendado). Use 0.0.0.0 apenas
# em rede confiável e, nesse caso, defina ACCESS_KEY.
HOST=127.0.0.1
PORT=5310
# Exige uma chave para iniciar sessão (recomendado se HOST não for 127.0.0.1).
ACCESS_KEY=
# Cookie só via HTTPS (ative se houver um proxy HTTPS na frente).
COOKIE_SECURE=false

# ── FFmpeg ──────────────────────────────────────────────────────────────────
# Nome no PATH ou caminho completo. Windows, por exemplo:
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#   FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Armazenamento ───────────────────────────────────────────────────────────
# Banco SQLite, uploads, saídas e temporários (relativo à pasta mediaforge/).
DATA_DIR=./data
# Sessões sem atividade por este tempo são apagadas (arquivos inclusive).
SESSION_TTL_HOURS=72
CLEANUP_INTERVAL_MIN=30

# ── Limites de entrada ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=4096
MAX_FILES_PER_UPLOAD=50
MAX_DURATION_SEC=10800
MAX_RESOLUTION=8192
MAX_ASSETS_PER_SESSION=500
MAX_JOBS_PER_SESSION=2000
MAX_JOBS_PER_BATCH=400

# ── Fila e recursos ─────────────────────────────────────────────────────────
# Tarefas simultâneas iniciais (ajustável na interface até MAX_CONCURRENCY).
DEFAULT_CONCURRENCY=2
MAX_CONCURRENCY=4
# Threads por processo FFmpeg (0 = automático).
FFMPEG_THREADS=0
# Prioridade dos processos FFmpeg (0 = normal … 19 = mais baixa).
PROCESS_NICE=10
# Tempo máximo por tarefa (segundos).
JOB_TIMEOUT_SEC=14400
# Tentativas automáticas para falhas transitórias (1 = sem repetição automática).
JOB_MAX_ATTEMPTS=2
# Não inicia novas tarefas se a memória livre ficar abaixo disto.
MIN_FREE_MEMORY_MB=256
# Verificação de reprodução após processar: full (arquivo inteiro), quick (início e fim), off.
VALIDATION_DECODE=full
# Duração máxima da prévia (segundos).
PREVIEW_MAX_SECONDS=8

# ── Diversos ────────────────────────────────────────────────────────────────
# Servir a interface compilada (web/dist) pelo próprio servidor.
SERVE_WEB=true
LOG_LEVEL=info
