{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Nexora Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@nexora/web"],
      "port": 5173
    },
    {
      "name": "Nexora API",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@nexora/api"],
      "port": 4000
    },
    {
      "name": "Nexora Worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:worker", "--workspace", "@nexora/api"]
    }
  ]
}
